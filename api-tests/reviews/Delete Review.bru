meta {
  name: Delete Review
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/reviews/PASTE_REVIEW_ID_HERE
  body: none
  auth: none
}

headers {
  Cookie: {{cookie}}
}

docs {
  Replace PASTE_REVIEW_ID_HERE with the id returned from Create Review.
  Returns 204 on success, 404 if not found or not yours.
}
