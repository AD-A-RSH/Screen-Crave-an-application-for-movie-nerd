meta {
  name: Get Movie
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/movies/27205
  body: none
  auth: none
}

docs {
  27205 = Inception. Returns full movie detail including a
  community_rating: { average, count } aggregate computed from ratings.
  Try a bogus id (e.g. 999999999) to see the 404 response.
}
